# Copy to .env and fill in values. Never commit .env.

# Server
PORT=8080

# PostgreSQL connection string
# Format: postgres://user:password@host:port/dbname?sslmode=disable
DATABASE_URL=postgres://postgres:password@localhost:5432/rep_set_lab?sslmode=disable

# JWT — use a long random string (e.g. openssl rand -hex 32)
JWT_SECRET=replace_with_random_secret

# AI Provider keys — only configure providers you want active
# Leave empty to disable a provider (it will be excluded from /ai/compare)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Exercise media sync — optional; GIF fetching via ExerciseDB (RapidAPI) is disabled when empty
EXERCISEDB_API_KEY=

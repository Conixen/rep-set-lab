# Copy to .env and fill in values. Never commit .env.

# Server
PORT=8080

# Comma-separated list of allowed CORS / WebSocket origins.
# In dev this defaults to http://localhost:5173 if unset.
# For a hosted deployment set this to your frontend URL, e.g.:
#   ALLOWED_ORIGINS=https://rep-set-lab.vercel.app
ALLOWED_ORIGINS=http://localhost:5173

# PostgreSQL connection string
# Format: postgres://user:password@host:port/dbname?sslmode=disable
DATABASE_URL=postgres://postgres:password@localhost:5432/rep_set_lab?sslmode=disable

# JWT — use a long random string (e.g. openssl rand -hex 32)
JWT_SECRET=replace_with_random_secret

# AI Provider keys — only configure providers you want active
# Leave empty to disable a provider (it will be excluded from /ai/compare)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Exercise media sync — optional; GIF fetching via ExerciseDB (RapidAPI) is disabled when empty
EXERCISEDB_API_KEY=

# Bootstrap admin — on startup, ensures this account exists and is active+admin.
# Set both or neither. Safe to leave set permanently (idempotent on every boot).
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
